[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=image/png;image/jpeg;image/webp;image/avif;image/heic;image/heif;image/bmp;image/tiff;image/gif;image/svg+xml;image/x-icon;
Actions=OpenStudio;CombineZip;CompressImg;CropImg;BackdropImg;AnnotateImg;RedactImg;AdjustImg;MetadataImg;ToWebp;ToPng;ToJpg;ToAvif;ToPdf;
X-KDE-Submenu=File Studio · Image
Icon=applications-graphics

[Desktop Action OpenStudio]
Name=Open in File Studio…
Icon=applications-graphics
Exec=/home/albraa/.local/bin/convertwheel --studio %F

[Desktop Action CompressImg]
Name=Compress Image (Smart Shrink)
Icon=archive-insert
Exec=/home/albraa/.local/bin/convertwheel --compress %F

[Desktop Action CropImg]
Name=Crop & Aspect Ratio…
Icon=transform-crop
Exec=/home/albraa/.local/bin/convertwheel --crop %u

[Desktop Action BackdropImg]
Name=Studio Backdrop & Frame…
Icon=color-picker
Exec=/home/albraa/.local/bin/convertwheel --addbg %u

[Desktop Action AnnotateImg]
Name=Annotate & Markup…
Icon=draw-freehand
Exec=/home/albraa/.local/bin/convertwheel --annotate %u

[Desktop Action RedactImg]
Name=Redact Sensitive Areas…
Icon=edit-clear
Exec=/home/albraa/.local/bin/convertwheel --redact %u

[Desktop Action AdjustImg]
Name=Adjust & Transform…
Icon=transform-rotate
Exec=/home/albraa/.local/bin/convertwheel --edit %u

[Desktop Action MetadataImg]
Name=Inspect & Strip EXIF…
Icon=document-properties
Exec=/home/albraa/.local/bin/convertwheel --metadata %u

[Desktop Action ToWebp]
Name=Convert → WEBP (Modern Web)
Icon=image-x-generic
Exec=/home/albraa/.local/bin/convertwheel --to WEBP %F

[Desktop Action ToPng]
Name=Convert → PNG (Lossless)
Icon=image-x-generic
Exec=/home/albraa/.local/bin/convertwheel --to PNG %F

[Desktop Action ToJpg]
Name=Convert → JPG (Compact)
Icon=image-x-generic
Exec=/home/albraa/.local/bin/convertwheel --to JPG %F

[Desktop Action ToAvif]
Name=Convert → AVIF (Next-Gen)
Icon=image-x-generic
Exec=/home/albraa/.local/bin/convertwheel --to AVIF %F

[Desktop Action ToPdf]
Name=Convert → PDF Document
Icon=application-pdf
Exec=/home/albraa/.local/bin/convertwheel --to PDF %F

[Desktop Action CombineZip]
Name=Combine into ZIP Archive
Icon=archive-insert
Exec=/home/albraa/.local/bin/convertwheel --zip %F
